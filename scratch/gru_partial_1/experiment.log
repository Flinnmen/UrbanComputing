  (relu): ReLU()
  (gcn_1): GCNConv(64, 64)
  (gcn_2): GCNConv(64, 64)
  (gcn_3): GCNConv(64, 64)
  (global_norm1): LayerNorm((64,), eps=1e-05, elementwise_affine=True)
  (global_norm2): LayerNorm((64,), eps=1e-05, elementwise_affine=True)
  (channel_up_sample): Linear(in_features=64, out_features=64, bias=True)
  (feature_aggregator): MultiHeadAttention(
    (w_qs): Linear(in_features=192, out_features=192, bias=False)
