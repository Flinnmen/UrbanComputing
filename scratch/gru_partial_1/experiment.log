  (drone_temporal): GRU(64, 64, num_layers=3, batch_first=True)
  (drone_norm): LayerNorm((64,), eps=1e-05, elementwise_affine=True)
  (ld_embedding): ValueEmbedding(d_model=64)
  (temporal_encoding_ld): LearnedPositionalEncoding(
    d_model=64, max_len=500, init_method='rand'
